# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or Atlas)
# If left as default and local MongoDB is not running, automatic in-memory fallback will start seamlessly for testing
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_qr_system

# JWT Authentication
JWT_SECRET=super_secret_restaurant_jwt_token_2026_antigravity_pos
JWT_EXPIRE=30d

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Optional Email Service for invoice dispatching
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@royaldine.com
